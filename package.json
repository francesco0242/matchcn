{
  "name": "matchcn",
  "version": "0.1.0",
  "description": "A semantic index across shadcn-format component registries: find a component by what it does, not what it is called.",
  "homepage": "https://matchcn.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francesco0242/matchcn.git"
  },
  "bugs": {
    "url": "https://github.com/francesco0242/matchcn/issues"
  },
  "license": "MIT",
  "author": "whosfranki",
  "keywords": [
    "shadcn",
    "mcp",
    "model-context-protocol",
    "component-registry",
    "ui-components",
    "ai-agent"
  ],
  "private": false,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "bin": {
    "matchcn": "bin/matchcn.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src/mcp-server.ts",
    "src/runtime",
    "data/tags"
  ],
  "scripts": {
    "mcp": "tsx src/mcp-server.ts",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0"
  }
}
